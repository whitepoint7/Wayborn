            fontFamily: 'Arial'
        }).setOrigin(0.5);
    }

    update() {
        // Saniyede 60 kez çalışan ana oyun döngüsü (Rüzgar, hareket, yön kontrolleri)
    }
}

// 2. Phaser Motorunun Genel Ayarları (Konfigürasyonu)
const config = {
    type: Phaser.AUTO, // Tarayıcıya göre WebGL veya Canvas seçer
    width: 1024,
    height: 768,
    parent: 'game-container', // HTML'de oluşturduğumuz div'in id'si
    physics: {
        default: 'arcade', // Prototipindeki ivmelenme ve drift için ideal hafif fizik motoru
        arcade: {
            gravity: { y: 0 }, // Top-down (üstten bakış) oyun olduğu için yerçekimi sıfır
            debug: true // Geliştirme aşamasında çarpışma kutularını (hitbox) görmek için true yaptık
        }
    },
    scene: [GameScene] // Sahnemizi motora tanıtıyoruz
};

// Oyunu başlat
const game = new Phaser.Game(config);
export default game;
