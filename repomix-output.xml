}

.action-item,
.action-subitem {
  position: absolute;
  left: 50%;
  top: calc(72px + (100% - 72px) / 2);
  width: 54px;
  height: 54px;
  border-radius: 999px;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(0.55);
  transition: transform 140ms ease, opacity 140ms ease;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
  font-size: 24px;
