<file path="src/styles.css">
html,
body,
#app {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: #07151f;
  color: #eef7f2;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  touch-action: manipulation;
}

canvas {
  display: block;
  image-rendering: pixelated;
  touch-action: none;
}

#ui-root {
  position: fixed;
  inset: 0;
  z-index: 12;
  pointer-events: none;
}

.hud-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  min-height: 38px;
  display: flex;
  align-items: flex-start;
  align-content: flex-start;
  flex-wrap: nowrap;
  gap: 4px;
  padding: calc(5px + env(safe-area-inset-top)) max(10px, env(safe-area-inset-right)) 5px max(10px, env(safe-area-inset-left));
  background: linear-gradient(180deg, rgba(5, 24, 34, 0.92), rgba(5, 24, 34, 0.58));
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  color: #eef7f2;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  z-index: 4;
}

.hud-detail-bar {
  position: absolute;
  top: calc(38px + env(safe-area-inset-top));
  left: 0;
  right: 0;
  height: 30px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 0 max(10px, env(safe-area-inset-right)) 5px max(10px, env(safe-area-inset-left));
  box-sizing: border-box;
  background: rgba(5, 24, 34, 0.72);
  z-index: 4;
  pointer-events: none;
}

.hud-detail-cell {
  min-width: 0;
  height: 24px;
  overflow: hidden;
  border: 0;
  border-left: 3px solid rgba(177, 235, 224, 0.62);
  background: rgba(5, 28, 38, 0.58);
  color: #f3fbf7;
