}

.action-subitem:nth-child(9) {
  --sx: 0px;
  --sy: -146px;
}

.action-subitem:nth-child(10) {
  --sx: 64px;
  --sy: -130px;
}

.action-subitem:nth-child(11) {
  --sx: 116px;
  --sy: -90px;
}

.action-subitem:nth-child(12) {
  --sx: 146px;
  --sy: -30px;
}

.action-subitem:nth-child(13) {
